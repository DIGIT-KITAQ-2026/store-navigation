# Supabaseへの接続情報。実際の値を入れたら `.env.local` にリネームして使う(.env.localは.gitignore済み)
# 参照: docs/データベース設計.md

# クライアント側で使う値(anon/publishableキー。公開されても問題ない値)
NEXT_PUBLIC_SUPABASE_URL=https://ptvlpipbvdkcmmsrbmwx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_cWm9iTSz5vC0HHAhZ0vpxQ_cmB56UPN

# サーバーサイド(Next.jsのAPI route)専用。RLSをバイパスする強い権限を持つため、
# 絶対にクライアントコードやリポジトリにコミットしない。
# Supabaseダッシュボード(Project Settings > API)から各自取得すること
SUPABASE_SERVICE_ROLE_KEY=

# 商品検索(/api/search)はAnthropicのAPIキーを使わず、`claude`コマンド(Claude Code CLI)を
# サーバーからサブプロセスとして呼び出し、claudeサブスクリプション認証をそのまま利用する。
# `next dev`/`next start`を実行するマシンで `claude login` 済みであれば、このトークンは不要。
# インタラクティブログインできない環境(本番デプロイ先など)でだけ、`claude setup-token` で
# 発行した長期トークンをここに設定する。
CLAUDE_CODE_OAUTH_TOKEN=

# 商品登録画面(/admin/products/new)で、商品バーコード(JANコード)スキャン直後に
# 商品名を自動入力するために使う。Yahoo!デベロッパーネットワーク
# (https://developer.yahoo.co.jp/)でアプリケーションを登録して取得する。
# 未設定でも動作する(自動入力されず手入力になるだけで、登録自体はブロックしない)。
YAHOO_SHOPPING_APP_ID=

# 消費者向け画面の多言語対応(日本語→英語・中国語・韓国語)で、商品名・説明文の翻訳に使う。
# Google Cloud ConsoleでCloud Translation APIを有効化し、このAPIのみに制限した
# APIキーを発行して設定する(https://console.cloud.google.com/apis/credentials)。
# 月50万文字まで無料。未設定の場合は翻訳されず日本語のまま表示される。
GOOGLE_TRANSLATE_API_KEY=

# ── ハイブリッドデプロイ(Vercel + 外部推論サーバー)用 ───────────────────
# 詳しい手順は docs/デプロイ手順.md を参照。
#
# Vercel等のサーバーレスでは、意味検索(ruri/e5)・画像検索(CLIP)・音声認識(Whisper)の
# モデルも`claude`コマンドも実行できない。この2つを設定すると、AI処理だけを
# 常時稼働している別マシンへHTTPで転送する。
#
# 未設定なら今までどおりこのプロセス内で実行する(ローカル開発・自前サーバー運用時は空のまま)。

# Vercel側にだけ設定する。推論サーバーの公開URL(末尾のスラッシュ不要)
AI_INFERENCE_BASE_URL=

# Vercel側と推論サーバー側の両方に、同じ値を設定する。
# 推論サーバーの /api/internal/* はトンネル経由で誰でも叩ける状態になるため、
# この値が一致しないリクエストは拒否する。推測されない十分長い文字列にすること
# (生成例: openssl rand -hex 32)。未設定だと推論サーバーは全リクエストを拒否する。
AI_INFERENCE_SHARED_SECRET=
